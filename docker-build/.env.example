# Copy to .env and adjust as needed (.env is gitignored)

# Harbor (HTTP only — host:port, no https://)
HARBOR_REGISTRY=192.168.216.140:8091
HARBOR_PROJECT=family-manage
HARBOR_USER=admin
# Must match Harbor admin password (or leave empty and use: docker login ... then SKIP_HARBOR_LOGIN=1)
HARBOR_PASSWORD=Harbor12345

# Images
IMAGE_TAG=latest
BACKEND_REPO=family-manage-backend
FRONTEND_REPO=family-manage-frontend

# Runtime
NETWORK_NAME=family-manage-net
BACKEND_CONTAINER=family-manage-backend
FRONTEND_CONTAINER=family-manage-frontend
BACKEND_HOST_PORT=12300
FRONTEND_HOST_PORT=8080
