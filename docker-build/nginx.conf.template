# 前端 nginx 配置模板（prd / uat / dev 共用）
#
# nginx 官方镜像启动时会执行 /docker-entrypoint.d/20-envsubst-on-templates.sh，
# 把 /etc/nginx/templates/*.template 中的 ${变量} 替换成容器环境变量后
# 输出为 /etc/nginx/conf.d/default.conf。
#
# 因此 ${BACKEND_HOST} 由部署脚本按环境注入：
#   prd -> family-manage-backend
#   uat -> family-manage-uat-backend
#   dev -> family-manage-dev-backend
#
# 注意：$uri / $host / $remote_addr 等是 nginx 自己的变量，不属于环境变量，
# 不会被 envsubst 替换。
server {
    listen 8091;
    server_name _;

    client_max_body_size 20m;

    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://${BACKEND_HOST}:12300/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
